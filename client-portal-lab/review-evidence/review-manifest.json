  "rubric": {
    "version": "rank-prompt S3 v1 - fixed before scoring; weights/anchors will not change mid-run",
    "dimensions": [
      {
        "id": "task_clarity",
        "label": "Task clarity and visual hierarchy",
        "weight": 25
      },
      {
        "id": "usability",
        "label": "Usability and interaction",
        "weight": 20
      },
      {
        "id": "visual_craft",
        "label": "Visual craft and legibility",
        "weight": 15
      },
      {
        "id": "responsive",
        "label": "Responsive layout",
        "weight": 15
      },
      {
        "id": "accessibility",
        "label": "Accessibility evidence",
        "weight": 15
      },
      {
        "id": "integrity",
        "label": "Content/spec/trust integrity",
        "weight": 10
      }
    ],
    "scale": "Integer 0-4 per dimension against S3 anchors; evidence note required per score",
    "formula": "total = sum(weight * dimension_score / 4); range 0-100, stored/displayed to 1 decimal",
    "critical_cap": "Total capped at 49 only for reproducible blocker (fails to load / primary content or action hidden/blocked at a required viewport / core task impossible)",
    "tie_rule": "Totals within 2.0 = practical tie group; tie-break: task-clarity, then fewer major/critical issues, then responsive; else joint rank"
  },
  "task_script_generic": [
    {
      "id": "T1",
      "task": "First screen: identify page purpose, current status, next useful action (desktop + mobile)"
    },
    {
      "id": "T2",
      "task": "Keyboard: Tab/Shift+Tab through first 15 focusables; focus visible? logical order? Enter/Space/Escape where apt"
    },
    {
      "id": "T3",
      "task": "Family core interaction (same per family: tab switch / primary CTA / drawer / filter / palette as documented)"
    },
    {
      "id": "T4",
      "task": "Theme switch to dark and back; state persists; no unreadable surface"
    },
    {
      "id": "T5",
      "task": "Demo-affordance honesty: documented demo control gives honest feedback, no fake success/navigation"
    },
    {
      "id": "T6",
      "task": "Mobile (390px): navigation reachable, no horizontal scroll, tap targets usable, sticky UI does not block core action"
    },
    {
      "id": "T7",
      "task": "Automated: axe-core on default state (+ open/validation state where meaningful); console/network errors recorded"
    }
  ],
